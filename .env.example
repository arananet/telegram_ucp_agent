# ── Telegram ──────────────────────────────────────────────────────────────────
# BotFather token: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghi

# Secret token sent in every webhook POST (X-Telegram-Bot-API-Secret-Token).
# Required in webhook mode; ignored when USE_POLLING=true.
TELEGRAM_WEBHOOK_SECRET=change_me_to_a_random_secret

# Full public HTTPS URL of this service, WITHOUT trailing slash.
# Railway sets this automatically; override if using a custom domain.
# Required in webhook mode; ignored when USE_POLLING=true.
WEBHOOK_URL=https://your-app.up.railway.app

# ── UCP Merchant ──────────────────────────────────────────────────────────────
# Base URL of the WooCommerce store with the UCP plugin installed.
UCP_MERCHANT_URL=https://your-woocommerce-store.example.com

# API key for authenticated UCP endpoints (sent as X-API-Key header).
UCP_API_KEY=your_ucp_api_key_here

# Optional payment token (e.g. Stripe token) passed to the complete endpoint.
# Leave empty to use COD / manual payment gateway on the WooCommerce side.
# UCP_PAYMENT_TOKEN=

# ── Runtime ───────────────────────────────────────────────────────────────────
# Server port. Railway injects PORT automatically; set 8080 for local dev.
PORT=8080

# Set to true to use long-polling instead of webhooks (local dev only).
USE_POLLING=false

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ── Rate Limiting ─────────────────────────────────────────────────────────────
# Max requests per user within the window (in-memory, resets on restart).
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60
