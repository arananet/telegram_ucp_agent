# ── Telegram ──────────────────────────────────────────────────────────────────
# BotFather token: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghi

# Secret token sent in every webhook POST (X-Telegram-Bot-API-Secret-Token).
# Required in webhook mode; ignored when USE_POLLING=true.
TELEGRAM_WEBHOOK_SECRET=change_me_to_a_random_secret

# Full public HTTPS URL of this service, WITHOUT trailing slash.
# Railway sets this automatically; override if using a custom domain.
# Required in webhook mode; ignored when USE_POLLING=true.
TELEGRAM_WEBHOOK_URL=https://your-app.up.railway.app

# ── UCP Merchant ──────────────────────────────────────────────────────────────
# Base REST URL of the WooCommerce UCP plugin (ends with /wp-json/ucp/v1).
UCP_BASE_URL=https://retrohardware.arananet.net/wp-json/ucp/v1

# API key for authenticated UCP endpoints (sent as X-API-Key header).
UCP_API_KEY=your_ucp_api_key_here

UCP_DISCOVERY_URL=https://retrohardware.arananet.net/.well-known/ucp
UCP_CHECKOUT_URL=https://retrohardware.arananet.net/wp-json/ucp/v1/checkout-sessions
UCP_CUSTOMER_PROFILE_URL=https://retrohardware.arananet.net/wp-json/ucp/v1/customers/me

# OAuth client configuration (required for /link).
# Comment these out to disable OAuth linking entirely.
UCP_CLIENT_ID=wc_ucp_client
UCP_CLIENT_SECRET=
UCP_REDIRECT_URI=https://bot.example.com/oauth/callback
UCP_OAUTH_SCOPE=checkout
UCP_OAUTH_AUTHORIZE=https://retrohardware.arananet.net/wp-json/ucp/v1/oauth/authorize
UCP_OAUTH_TOKEN=https://retrohardware.arananet.net/wp-json/ucp/v1/oauth/token
UCP_OAUTH_REVOKE=https://retrohardware.arananet.net/wp-json/ucp/v1/oauth/revoke

# Database used to persist per-user OAuth tokens + pending states.
# Supports any SQLAlchemy DSN (SQLite shown here).
DB_URL=sqlite:///tokens.db

# Optional payment token (e.g. Stripe payment method ID) passed to the complete endpoint.
# Leave empty to use COD / manual payment gateway on the WooCommerce side.
# UCP_PAYMENT_TOKEN=

# PSP credential placeholders (only if you mint payment tokens from the bot).
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# AP2_CREDENTIALS_JSON=

# ── Runtime ───────────────────────────────────────────────────────────────────
# Server port. Railway injects PORT automatically; set 8080 for local dev.
PORT=8080

# Set to true to use long-polling instead of webhooks (local dev only).
USE_POLLING=false

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ── Rate Limiting ─────────────────────────────────────────────────────────────
# Max requests per user within the window (in-memory, resets on restart).
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60
